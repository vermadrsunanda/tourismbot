# Streamlit Secrets Configuration
# For local development: copy this to .streamlit/secrets.toml and add your actual API key
# For Streamlit Cloud: add these secrets via the app settings dashboard

# Mistral AI API Key
# Get your key from: https://console.mistral.ai/api-keys/
MISTRAL_API_KEY = "your-mistral-api-key-here"

# Optional: Flask environment
FLASK_ENV = "development"

# Optional: Secret key for sessions
SECRET_KEY = "tourism-bot-dev-secret-key-change-in-production"

# Optional: Log level
LOG_LEVEL = "INFO"
